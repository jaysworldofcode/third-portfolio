# Copy this file to .env.local and fill in the values for the email provider
# chosen in content/site.json (contact.notifications.provider).
# Never put these values in content/site.json: that file is sent to every visitor.

# --- SMTP (provider: "smtp") -------------------------------------------------
# Gmail:   SMTP_HOST=smtp.gmail.com       SMTP_PORT=465  (use an App Password)
# Outlook: SMTP_HOST=smtp.office365.com   SMTP_PORT=587
# Zoho:    SMTP_HOST=smtp.zoho.com        SMTP_PORT=465
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
# Optional. Sender address; defaults to SMTP_USER.
SMTP_FROM=

# --- Resend (provider: "resend") ---------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Optional. An address on a domain verified in Resend. Without it, Resend's test
# sender is used, which can only deliver to your Resend account's own email.
RESEND_FROM=

# --- Supabase (currently disabled) -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
